# API / shared
NODE_ENV=development
PORT=3001
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
TOKEN_ENCRYPTION_KEY=replace-with-32-plus-character-dev-key
SERVICE_M2M_KEY=replace-with-16-plus-character-dev-key
AI_BASE_URL=http://127.0.0.1:8000
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
SENTRY_DSN=
PLATFORM_ADMIN_EMAILS=
AI_MODEL_ALLOWLIST=gemini-2.0-flash
DEFAULT_AI_DRAFT_MAX_AMOUNT_VND=5000000
# Meta — OAuth redirect = web app (port 3000); webhook callback = API /v1/webhooks/meta (tunnel :3001)
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_VERIFY_TOKEN=replace-with-8-plus-char-verify-token
META_REDIRECT_URI=http://127.0.0.1:3000/settings/channels/callback
META_GRAPH_VERSION=v21.0

# Zalo OA — connect uses an existing OA access token; webhook secret is optional.
ZALO_WEBHOOK_SECRET=

# Web
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# AI service
CORE_BASE_URL=http://127.0.0.1:3001
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_DAILY_SPEND_CAP_USD=0
LLM_MONTHLY_SPEND_CAP_USD=0
GEMINI_USD_PER_1K_INPUT_TOKENS=0.0001
GEMINI_USD_PER_1K_OUTPUT_TOKENS=0.0004
LLM_SPEND_COUNTER_PATH=.llm-spend.json
