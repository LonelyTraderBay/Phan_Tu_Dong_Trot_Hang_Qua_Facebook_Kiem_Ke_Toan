{
  "name": "omni-commerce",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:isolation": "pnpm --dir apps/api exec vitest run --root ../../tests/isolation cross-tenant",
    "test:eval": "uv run --directory apps/ai python ../../tests/eval/run_stub.py",
    "dev": "turbo run dev --parallel"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "eslint": "^10.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
